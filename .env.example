# LiveKit SFU Configuration
# Get free credentials at https://cloud.livekit.io or run a local Docker server:
# docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server --dev

# LiveKit Cloud or Local SFU Server WebSocket URL
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key and Secret for generating participant tokens
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# PostgreSQL Database URL for Prisma Backend
DATABASE_URL="postgresql://user:password@localhost:5432/meet_db?schema=public"

